<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>Umbraco Semantic Search Qdrant Provider</Title>
        <RootNamespace>Argentini.Umbraco.Search.Qdrant</RootNamespace>

        <AssemblyVersion>18.0.6</AssemblyVersion>
        <FileVersion>18.0.6</FileVersion>
        <PackageVersion>18.0.6</PackageVersion>

        <PackageId>argentini.umbraco.search.qdrant</PackageId>
        <Authors>Michael Argentini</Authors>
        <Company>Argentini Unlimited, Ltd</Company>
        <Description>Qdrant vector store support for Umbraco semantic search.</Description>
        <Copyright>Copyright (c) 2026 Argentini Unlimited, Ltd</Copyright>
        <PackageTags>umbraco;qdrant;semantic-search;vector-search</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReleaseNotes>Package updates (Umbraco.AI 18.0.5).</PackageReleaseNotes>
        <PackageIcon>nuget-icon.png</PackageIcon>
        <PackageOutputPath>nupkg</PackageOutputPath>
        <PackageProjectUrl>https://github.com/argentini/Argentini.Umbraco.Search.Qdrant</PackageProjectUrl>
        <RepositoryUrl>https://github.com/argentini/Argentini.Umbraco.Search.Qdrant</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Qdrant.Client" Version="1.20.0" />
        <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
        <PackageReference Include="Umbraco.AI.Search" Version="18.0.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- These override Umbraco dependencies with security vulnerabilities -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
        <PackageReference Include="MessagePack.AspNetCoreMvcFormatter" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <None Include="nuget-icon.png" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
        <None Include="appsettings-schema.Umbraco.Search.Qdrant.json" Pack="true" PackagePath="contentFiles/any/any/;content/" CopyToOutputDirectory="Always" />
        <None Include="..\README.md" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="" CopyToOutputDirectory="Always" />
    </ItemGroup>
    
</Project>
